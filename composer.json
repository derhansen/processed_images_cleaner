{
  "name": "derhansen/processed-images-cleaner",
  "type": "typo3-cms-extension",
  "description": "Symfony console command to clean up processed images by several conditions",
  "homepage": "https://github.com/derhansen/processed_images_cleaner",
  "support": {
    "issues": "https://github.com/derhansen/processed_images_cleaner/issues"
  },
  "authors": [
    {
      "name": "Torben Hansen",
      "email": "torben@derhansen.com",
      "homepage": "https://www.derhansen.com",
      "role": "Developer"
    }
  ],
  "keywords": ["TYPO3 CMS", "cleanup", "processed", "images"],
  "license": [
    "GPL-2.0-or-later"
  ],
  "require": {
    "typo3/cms-core": "^14.3 || ^13.4 || ^12.4"
  },
  "autoload": {
    "psr-4": {
      "Derhansen\\ProcessedImagesCleaner\\": "Classes"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Derhansen\\ProcessedImagesCleaner\\Tests\\": "Tests"
    }
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "processed_images_cleaner",
      "version": "1.1.3",
      "Package": {
        "providesPackages": []
      }
    }
  }
}
